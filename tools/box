#!/bin/sh
''''command -v python3 >/dev/null 2>&1 && python3 -c '' 2>/dev/null && MSYS_NO_PATHCONV=1 exec python3 "$0" "$@"; MSYS_NO_PATHCONV=1 exec python "$0" "$@" # '''
# Run a command in an agent system's docker image, with the tutorial mounted at /work.
#
#   tools/box <image> <system> [-d] <command ...>
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
from hpclab import Box

if len(sys.argv) < 4:
    sys.exit("usage: tools/box <image> <system> [-d] <command ...>")
Box(sys.argv[1], sys.argv[2]).main(sys.argv[3:])
