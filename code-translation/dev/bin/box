#!/bin/sh
''''command -v python3 >/dev/null 2>&1 && python3 -c '' 2>/dev/null && MSYS_NO_PATHCONV=1 exec python3 "$0" "$@"; MSYS_NO_PATHCONV=1 exec python "$0" "$@" # '''
# Run a command in the hpc-lab-translate image, from code-translation/.
#
#   dev/bin/box make -C app
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "tools"))
from hpclab import Box

BOX = Box("hpc-lab-translate", "code-translation")
BOX.main(sys.argv[1:])
