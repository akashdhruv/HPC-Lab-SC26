#!/bin/sh
''''command -v python3 >/dev/null 2>&1 && python3 -c '' 2>/dev/null && MSYS_NO_PATHCONV=1 exec python3 "$0" "$@"; MSYS_NO_PATHCONV=1 exec python "$0" "$@" # '''
# Which Fortran units can be translated now, computed in the container.
#
#   dev/bin/readiness [--json]
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parents[3] / "tools"))
from hpclab import Container

CONTAINER = Container.of(__file__)
sys.exit(CONTAINER.run(["python3", "dev/tools/index.py", *sys.argv[1:]]))
