diff --git a/mxp-optimization/app/src/io.cpp b/mxp-optimization/app/src/io.cpp
index 99c4b5b..5aff470 100644
--- a/mxp-optimization/app/src/io.cpp
+++ b/mxp-optimization/app/src/io.cpp
@@ -96,6 +96,37 @@ std::string pvtiName(int step) {
     return std::string(buf);
 }
 
+// RAPTOR-BEGIN: errors vs the fp64 shadow
+void errorsVsShadow(const Grid& g, const std::vector<double>& dfun,
+                    const std::vector<double>& shadow, Diagnostics& d) {
+    const double eps = heavisideWidth(g);
+    double local[2] = {0.0, 0.0};  // sum of squares, max
+    double shape[2] = {0.0, 0.0};  // sum |H(dfun) - H(shadow)|, sum delta(shadow) |grad shadow|
+    for (int j = 0; j < g.ny(); ++j) {
+        for (int i = 0; i < g.nx(); ++i) {
+            const double e = std::fabs(dfun[g.index(i, j)] - shadow[g.index(i, j)]);
+            local[0] += e * e;
+            if (e > local[1]) local[1] = e;
+            const double s = shadow[g.index(i, j)];
+            shape[0] += std::fabs(smoothedHeaviside(dfun[g.index(i, j)], eps) - smoothedHeaviside(s, eps));
+            if (std::fabs(s) < eps) {
+                const double gx = (shadow[g.index(i + 1, j)] - shadow[g.index(i - 1, j)]) / (2.0 * g.dx());
+                const double gy = (shadow[g.index(i, j + 1)] - shadow[g.index(i, j - 1)]) / (2.0 * g.dy());
+                shape[1] += (1.0 + std::cos(kPi * s / eps)) / (2.0 * eps) * std::sqrt(gx * gx + gy * gy);
+            }
+        }
+    }
+    double sum = 0.0;
+    double total[2] = {0.0, 0.0};
+    MPI_Allreduce(&local[0], &sum, 1, MPI_DOUBLE, MPI_SUM, g.comm());
+    MPI_Allreduce(&local[1], &d.err_max, 1, MPI_DOUBLE, MPI_MAX, g.comm());
+    MPI_Allreduce(shape, total, 2, MPI_DOUBLE, MPI_SUM, g.comm());
+    d.err_rms = std::sqrt(sum / (double(g.nxGlobal()) * g.nyGlobal()));
+    // The cell area cancels; dividing by dx gives cells.
+    d.err_shape = (total[1] > 0.0) ? total[0] / (total[1] * g.dx()) : 0.0;
+}
+// RAPTOR-END
