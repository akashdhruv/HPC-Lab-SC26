 namespace {
 
@@ -13,6 +14,8 @@ inline double sqr(double x) { return x * x; }
 
 }  // namespace
 
+// RAPTOR-BEGIN: EVOLVE-BLOCK, the FP64 kernel that RAPTOR truncates
+// EVOLVE-BLOCK-START
 double wenoFaceValue(double s1, double s2, double s3, double s4, double s5, bool positive) {
     // Smoothness indicators (identical in both branches).
     const double rIS1 = (13.0 / 12.0) * sqr(s1 - 2.0 * s2 + s3) +
@@ -119,3 +122,26 @@ void advectWeno(const Grid& g, const std::vector<double>& phi, const std::vector
         }
     }
 }
+// EVOLVE-BLOCK-END
+// RAPTOR-END
+
+// RAPTOR-BEGIN: advectWeno at precision m (RAPTOR emulates fp32, bf16 and fp8 e4m3)
+void advectWenoAt(Precision m, const Grid& g, const std::vector<double>& phi,
+                  const std::vector<double>& u, const std::vector<double>& v,
+                  std::vector<double>& rhs) {
+    if (m == Precision::kFp64) {
+        advectWeno(g, phi, u, v, rhs);
+#ifdef BUBBLE_RAPTOR
+    } else if (m == Precision::kFp32) {
+        // Arguments: function, from fp64, to MPFR (1), exponent bits, mantissa bits.
+        __raptor_truncate_op_func(advectWeno, 64, 1, 8, 23)(g, phi, u, v, rhs);
+    } else if (m == Precision::kBf16) {
+        __raptor_truncate_op_func(advectWeno, 64, 1, 8, 7)(g, phi, u, v, rhs);
+    } else if (m == Precision::kFp8) {
+        __raptor_truncate_op_func(advectWeno, 64, 1, 4, 3)(g, phi, u, v, rhs);
+#endif
+    } else {
+        throw std::invalid_argument("this precision needs a RAPTOR=1 build");
+    }
+}
+// RAPTOR-END
