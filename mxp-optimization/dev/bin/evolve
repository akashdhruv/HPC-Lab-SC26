#!/bin/sh
"export" "MSYS_NO_PATHCONV=1"
"exec" "$(python3 -c '' 2>/dev/null && echo python3 || echo python)" "$0" "$@"
# The OpenEvolve search of an optimize run, detached.
# Runs Mxp.evolve (mxp-optimization/dev/tools.py); --help for its usage.
# Lines 2-3 rerun this file under python3 (or python) from any shell; to Python they are strings.

import sys
from pathlib import Path

root = next(p for p in Path(__file__).resolve().parents if (p / "tools" / "hpclab.py").is_file())
sys.path.insert(0, str(root / "tools"))

import hpclab

hpclab.main(__file__)
